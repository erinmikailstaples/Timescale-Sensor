# Copy this file to oura/.env and fill in real values.
# oura/.env is ignored by Git. Never commit it or paste it into chat or issues.

# OAuth application credentials from https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=YOUR_OAUTH2_CLIENT_ID
OURA_CLIENT_SECRET=YOUR_OAUTH2_CLIENT_SECRET

# Tokens returned after the user authorizes the application (see oura/README.md).
# read_oura.py needs the access token; sync_to_tiger.py refreshes it with the others.
OURA_ACCESS_TOKEN=YOUR_OAUTH2_ACCESS_TOKEN
OURA_REFRESH_TOKEN=YOUR_OAUTH2_REFRESH_TOKEN

# Optional. Needed by setup_schema.py, sync_to_tiger.py, and export_to_tiger.py.
# Paste the URI from Tiger Cloud's Connect panel. Keep sslmode=require.
# If you leave this out, the scripts fall back to tiger-cloud-credentials.txt.
#DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
