# Copy this file to awear/.env and fill in real values.
# awear/.env is ignored by Git. Never commit it or paste it into chat or issues.

# Required for fetch_data.py. Your research-group key from https://awearlabs.com/
AWEAR_API_KEY=awr_sk_your_api_key_here

# Optional. Only needed by upload_to_tiger.py. Paste the URI from Tiger Cloud's
# Connect panel or from `tiger db uri --with-password`. Keep sslmode=require.
# If you leave this out, the uploader also looks in the repository root .env.
#DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
